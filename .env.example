# MongoDB connection string (Prisma)
# Atlas example:
DATABASE_URL="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/mydb?retryWrites=true&w=majority"
# docker compose (local mongodb service) example:
# DATABASE_URL="mongodb://mongodb:27017/app?replicaSet=rs0"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Redis (BullMQ job queue between the app and the worker)
REDIS_URL="redis://localhost:6379"

# S3-compatible object storage for VODs and derived media.
# Local (docker compose `storage` service):
S3_ENDPOINT="http://localhost:8333"
S3_PUBLIC_ENDPOINT="http://localhost:8333"
S3_FORCE_PATH_STYLE="true"
S3_REGION="us-east-1"
S3_BUCKET="vods"
S3_ACCESS_KEY_ID="devaccesskey"
S3_SECRET_ACCESS_KEY="devsecretkey"
# Cloudflare R2 example (bucket CORS must allow PUT from the app origin and
# expose the ETag header):
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_PUBLIC_ENDPOINT=""   (same as S3_ENDPOINT)
# S3_FORCE_PATH_STYLE="false"
# S3_REGION="auto"

# Analysis (worker). Everything is free and local by default.
# Transcription: "auto" uses the GPU service (transcriber/server.py) when it
# runs, else the CPU in Docker. Also "remote", "local" (CPU) or "deepgram".
TRANSCRIBE_PROVIDER="auto"
# TRANSCRIBER_URL="http://host.docker.internal:8765"
# base: ~15 min per 4 h of stream on an M1, no punctuation.
# small: ~45 min per 4 h, punctuated (cleaner cuts).
WHISPER_MODEL="small"
# Language spoken on stream (fr, en…); empty = auto-detect.
WHISPER_LANGUAGE="fr"
# Highlight detection: "heuristic" (signals only), "ollama" (local LLM,
# needs `ollama serve` + `ollama pull qwen2.5:3b`) or "claude" (paid).
ANALYSIS_PROVIDER="heuristic"
# OLLAMA_MODEL="qwen2.5:3b"
# Paid providers, only needed if selected above:
# DEEPGRAM_API_KEY=""
# ANTHROPIC_API_KEY=""
# Twitch imports: max video height (720 ≈ 1.5 GB per hour of stream; source
# 1080p60 can reach 3-6 GB/h) and disk space always kept free during imports.
# TWITCH_MAX_HEIGHT="720"
# MIN_FREE_DISK_GB="5"

# Public site (SEO, legal pages). Set NEXT_PUBLIC_SITE_URL to the production
# domain: canonical URLs, sitemap and social images are built from it.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL="contact@example.com"
# Shown in the legal notice and privacy policy: fill in before launch.
# NEXT_PUBLIC_LEGAL_COMPANY="Ma Société SAS"
# NEXT_PUBLIC_LEGAL_ADDRESS="1 rue Exemple, 75000 Paris"
# NEXT_PUBLIC_LEGAL_REGISTRATION="RCS Paris 000 000 000"
# NEXT_PUBLIC_LEGAL_DIRECTOR="Prénom Nom"
# NEXT_PUBLIC_LEGAL_HOST="Hébergeur, adresse, téléphone"

# Emails (password reset). Without SMTP_URL, emails are printed in the server
# console. Example: smtps://user:pass@smtp.example.com:465
# SMTP_URL=""
# MAIL_FROM="Condensé <no-reply@example.com>"
